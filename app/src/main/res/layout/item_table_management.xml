<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:gravity="center_horizontal"
    android:layout_margin="6dp"
    android:background="@drawable/bg_table_available"
    android:padding="10dp">

    <!-- Tên bàn — cùng id với item_table.xml gốc -->
    <TextView
        android:id="@+id/tv_table_name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textStyle="bold"
        android:textSize="15sp"
        android:textColor="@color/text_primary" />

    <!-- Zone — id mới tránh trùng -->
    <TextView
        android:id="@+id/tv_table_management_zone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textSize="11sp"
        android:textColor="@color/text_secondary"
        android:layout_marginTop="2dp" />

    <!-- Trạng thái — cùng id với item_table.xml gốc -->
    <TextView
        android:id="@+id/tv_table_status"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textSize="12sp"
        android:textColor="@color/text_secondary"
        android:layout_marginTop="6dp" />

    <!-- Nút Trả bàn — id mới, chỉ hiện khi OCCUPIED -->
    <Button
        android:id="@+id/btn_table_release"
        android:layout_width="match_parent"
        android:layout_height="34dp"
        android:layout_marginTop="8dp"
        android:text="@string/release_table"
        android:textSize="12sp"
        android:textStyle="bold"
        android:background="@drawable/bg_btn_primary"
        android:visibility="gone" />

</LinearLayout>