<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="16dp"
    android:background="#FAFAFA">

    <com.google.android.material.imageview.ShapeableImageView
        android:id="@+id/imgCartItem"
        android:layout_width="64dp"
        android:layout_height="64dp"
        android:scaleType="centerCrop"
        android:src="@drawable/placeholder_coffee"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:shapeAppearanceOverlay="@style/RoundedSmall" />

    <TextView
        android:id="@+id/txtCartItemName"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="8dp"
        android:textColor="#2D1A11"
        android:textSize="16sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toStartOf="@+id/txtCartItemPrice"
        app:layout_constraintStart_toEndOf="@+id/imgCartItem"
        app:layout_constraintTop_toTopOf="@+id/imgCartItem" />

    <TextView
        android:id="@+id/txtCartItemDetails"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:textColor="#757575"
        android:textSize="12sp"
        app:layout_constraintEnd_toEndOf="@+id/txtCartItemName"
        app:layout_constraintStart_toStartOf="@+id/txtCartItemName"
        app:layout_constraintTop_toBottomOf="@+id/txtCartItemName" />

    <TextView
        android:id="@+id/txtCartItemPrice"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="#2D1A11"
        android:textSize="16sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/txtCartItemName" />

</androidx.constraintlayout.widget.ConstraintLayout>