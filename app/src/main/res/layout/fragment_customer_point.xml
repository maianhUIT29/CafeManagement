<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F5F5"
    android:padding="24dp">

    <!-- Khu vực Tổng điểm và Tiến trình -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardProgress"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardBackgroundColor="#FFFFFF"
        app:cardCornerRadius="16dp"
        app:strokeWidth="0dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="20dp">

            <TextView
                android:id="@+id/lblTotalPoints"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Điểm hiện tại"
                android:textColor="#757575"
                android:textSize="14sp"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent" />

            <TextView
                android:id="@+id/txtTotalPoints"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#FF9800"
                android:textSize="36sp"
                android:textStyle="bold"
                tools:text="45"
                app:layout_constraintTop_toBottomOf="@id/lblTotalPoints"
                app:layout_constraintStart_toStartOf="parent" />

            <!-- Thanh tiến trình tích điểm -->
            <com.google.android.material.progressindicator.LinearProgressIndicator
                android:id="@+id/progressBarPoints"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                app:indicatorColor="#4CAF50"
                app:trackColor="#E0E0E0"
                app:trackThickness="8dp"
                app:trackCornerRadius="4dp"
                tools:progress="45"
                app:layout_constraintTop_toBottomOf="@id/txtTotalPoints" />

            <TextView
                android:id="@+id/txtProgressMessage"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:textColor="#424242"
                android:textSize="14sp"
                tools:text="Bạn cần mua thêm 55 điểm để nhận Voucher 5%"
                app:layout_constraintTop_toBottomOf="@id/progressBarPoints" />

        </androidx.constraintlayout.widget.ConstraintLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Khu vực Lịch sử hóa đơn -->
    <TextView
        android:id="@+id/lblHistory"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:text="Lịch sử tích điểm"
        android:textColor="#212121"
        android:textSize="18sp"
        android:textStyle="bold"
        app:layout_constraintTop_toBottomOf="@id/cardProgress"
        app:layout_constraintStart_toStartOf="parent" />

    <!-- Danh sách hiển thị điểm cộng -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerPointHistory"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="12dp"
        app:layout_constraintTop_toBottomOf="@id/lblHistory"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>